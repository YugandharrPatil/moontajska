---
import { Image } from "astro:assets";
import logo from "../assets/Moontajska_logo.png";
import PillButton from "./ui/pill-button.astro";
import { Button } from "./ui/button";
import { Menu, X } from "lucide-react";

const LINKS = [
	// {
	// 	id: 1,
	// 	text: "about",
	// 	href: "/about",
	// },
	{
		id: 1,
		text: "director",
		href: "/director",
	},
	{
		id: 2,
		text: "portfolio",
		href: "/portfolio",
	},
	{
		id: 3,
		text: "clients",
		href: "/#clients",
	},
	{
		id: 4,
		text: "book a call",
		href: "/#book-us",
	},
];
---

<header class="bg-white sticky top-0 z-50">
	<div class="w-full max-w-300 mx-auto px-4 md:px-8 py-4 md:py-6 flex justify-between items-center relative">
		<div class="logo-container">
			<a href="/">
				<Image
					src={logo}
					alt="Moontajska Productions"
					class="h-10 md:h-12 w-auto object-contain"
				/>
			</a>
		</div>
		<nav class="flex items-center">
			<div class="hidden md:flex items-center gap-24">
				<div class="flex items-center gap-10">
					{LINKS.filter((l) => l.href !== "/#book-us").map((link) => {
						return (
							<a
								href={link.href}
								class="text-base transition-opacity hover:opacity-60 font-jost"
							>
								{link.text}
							</a>
						);
					})}
				</div>
				{LINKS.filter((l) => l.href === "/#book-us").map((link) => (
					<PillButton href={link.href} text="book a call" />
				))}
			</div>
			<Button
				id="mobile-menu-btn"
				variant="outline"
				size="icon"
				className="md:hidden"
				aria-label="Menu"
				aria-expanded="false"
			>
				<Menu id="mobile-menu-icon" className="size-5 text-foreground" />
				<X id="mobile-close-icon" className="size-5 text-foreground hidden" />
			</Button>
		</nav>

		<!-- Mobile Menu -->
		<div
			id="mobile-menu"
			class="hidden absolute top-full left-0 w-full bg-white flex-col items-center gap-6 py-8 shadow-xl border-t border-gray-100 md:hidden z-50"
		>
			{LINKS.map((link) => (
				<a
					href={link.href}
					class={
						link.href === "/#book-us"
							? "text-sm font-jost border border-black px-6 py-2 rounded-full tracking-[1px] text-[#1a1a1a] transition-all hover:bg-black hover:text-white"
							: "text-[0.85rem] font-light tracking-[2px] text-[#1a1a1a] transition-opacity hover:opacity-60"
					}
				>
					{link.text}
				</a>
			))}
		</div>
	</div>
</header>

<script>
	function setupMobileMenu() {
		const menuBtn = document.getElementById("mobile-menu-btn");
		const mobileMenu = document.getElementById("mobile-menu");
		const menuIcon = document.getElementById("mobile-menu-icon");
		const closeIcon = document.getElementById("mobile-close-icon");

		if (!menuBtn || !mobileMenu) return;

		const toggleMenu = () => {
			const isClosed = mobileMenu.classList.contains("hidden");
			if (isClosed) {
				mobileMenu.classList.remove("hidden");
				mobileMenu.classList.add("flex");
				menuBtn.setAttribute("aria-expanded", "true");
				menuIcon?.classList.add("hidden");
				closeIcon?.classList.remove("hidden");
			} else {
				mobileMenu.classList.add("hidden");
				mobileMenu.classList.remove("flex");
				menuBtn.setAttribute("aria-expanded", "false");
				menuIcon?.classList.remove("hidden");
				closeIcon?.classList.add("hidden");
			}
		};

		menuBtn.onclick = toggleMenu;

		const links = mobileMenu.querySelectorAll("a");
		links.forEach((link) => {
			link.onclick = () => {
				mobileMenu.classList.add("hidden");
				mobileMenu.classList.remove("flex");
				menuBtn.setAttribute("aria-expanded", "false");
				menuIcon?.classList.remove("hidden");
				closeIcon?.classList.add("hidden");
			};
		});
	}

	// Re-run on initial load and Astro client navigation (ClientRouter)
	document.addEventListener("astro:page-load", setupMobileMenu);
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", setupMobileMenu);
	} else {
		setupMobileMenu();
	}
</script>
