---
import { Image } from "astro:assets";
import logo from "../assets/Moontajska_logo.png";
import PillButton from "./ui/pill-button.astro";

const LINKS = [
	// {
	// 	id: 1,
	// 	text: "about",
	// 	href: "/about",
	// },
	{
		id: 1,
		text: "director",
		href: "/director",
	},
	{
		id: 2,
		text: "portfolio",
		href: "/portfolio",
	},
	{
		id: 3,
		text: "clients",
		href: "/#clients",
	},
	{
		id: 4,
		text: "book a call",
		href: "/#book-us",
	},
];
---

<header class="bg-white sticky top-0 z-50">
	<div class="w-full max-w-300 mx-auto px-4 md:px-8 py-4 md:py-6 flex justify-between items-center relative">
		<div class="logo-container">
			<a href="/">
				<Image
					src={logo}
					alt="Moontajska Productions"
					class="h-10 md:h-12 w-auto object-contain"
				/>
			</a>
		</div>
		<nav class="flex items-center">
			<div class="hidden md:flex items-center gap-24">
				<div class="flex items-center gap-10">
					{LINKS.filter((l) => l.href !== "/#book-us").map((link) => {
						return (
							<a
								href={link.href}
								class="text-base transition-opacity hover:opacity-60 font-jost"
							>
								{link.text}
							</a>
						);
					})}
				</div>
				{LINKS.filter((l) => l.href === "/#book-us").map((link) => (
					<PillButton href={link.href} text="book a call" />
				))}
			</div>
			<button
				id="mobile-menu-btn"
				class="md:hidden bg-transparent border-none cursor-pointer p-2 transition-transform hover:scale-105"
				aria-label="Menu"
			>
				<svg
					width="28"
					height="20"
					viewBox="0 0 32 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<rect width="32" height="3" fill="#1a1a1a"></rect>
					<rect y="10" width="32" height="3" fill="#1a1a1a"></rect>
					<rect y="20" width="24" height="3" fill="#1a1a1a"></rect>
					<path d="M28 26L24 20H32L28 26Z" fill="#1a1a1a"></path>
				</svg>
			</button>
		</nav>

		<!-- Mobile Menu -->
		<div
			id="mobile-menu"
			class="hidden absolute top-full left-0 w-full bg-white flex-col items-center gap-6 py-8 shadow-xl border-t border-gray-100 md:hidden"
		>
			{LINKS.map((link) => (
				<a
					href={link.href}
					class={
						link.href === "/#book-us"
							? "text-sm font-jost border border-black px-6 py-2 rounded-full tracking-[1px] text-[#1a1a1a] transition-all hover:bg-black hover:text-white"
							: "text-[0.85rem] font-light tracking-[2px] text-[#1a1a1a] transition-opacity hover:opacity-60"
					}
				>
					{link.text}
				</a>
			))}
		</div>
	</div>
</header>

<script>
	const menuBtn = document.getElementById("mobile-menu-btn");
	const mobileMenu = document.getElementById("mobile-menu");

	menuBtn?.addEventListener("click", () => {
		mobileMenu?.classList.toggle("hidden");
		mobileMenu?.classList.toggle("flex");
	});
</script>
