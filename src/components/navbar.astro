---
import { Image } from "astro:assets";
import logo from "../assets/Moontajska_logo.png";

const LINKS = [
	{
		id: 1,
		text: "about",
		href: "/about",
	},
	{
		id: 1,
		text: "portfolio",
		href: "/portfolio",
	},
	{
		id: 1,
		text: "clients",
		href: "/clients",
	},
	{
		id: 1,
		text: "contact",
		href: "/contact",
	},
];
---

<header class="bg-white sticky top-0 z-50">
	<div
		class="w-full max-w-300 mx-auto px-4 md:px-8 py-4 md:py-6 flex justify-between items-center relative"
	>
		<div class="logo-container">
			<a href="/">
				<Image
					src={logo}
					alt="Moontajska Productions"
					class="h-10 md:h-12 w-auto object-contain"
				/>
			</a>
		</div>
		<nav class="flex items-center gap-8">
			<div class="hidden md:flex items-center gap-4">
				{
					LINKS.map((link, i) => {
						return (
							<a
								href={link.href}
								class="text-[0.85rem] font-light tracking-[2px] text-[#1a1a1a] transition-opacity hover:opacity-60 uppercase"
							>
								{link.text}
							</a>
						<span class="text-[0.85rem] text-[#666]">{i < 3 && "·"}</span>
						);
					})
				}
			</div>
			<button
				id="mobile-menu-btn"
				class="md:hidden bg-transparent border-none cursor-pointer p-2 transition-transform hover:scale-105"
				aria-label="Menu"
			>
				<svg
					width="28"
					height="20"
					viewBox="0 0 32 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<rect width="32" height="3" fill="#1a1a1a"></rect>
					<rect y="10" width="32" height="3" fill="#1a1a1a"></rect>
					<rect y="20" width="24" height="3" fill="#1a1a1a"></rect>
					<path d="M28 26L24 20H32L28 26Z" fill="#1a1a1a"></path>
				</svg>
			</button>
		</nav>

		<!-- Mobile Menu -->
		<div
			id="mobile-menu"
			class="hidden absolute top-full left-0 w-full bg-white flex-col items-center gap-6 py-8 shadow-xl border-t border-gray-100 md:hidden"
		>
			<a
				href="/talents"
				class="text-[0.85rem] font-light tracking-[2px] text-[#1a1a1a] transition-opacity hover:opacity-60"
				>TALENTS</a
			>
			<a
				href="/clients"
				class="text-[0.85rem] font-light tracking-[2px] text-[#1a1a1a] transition-opacity hover:opacity-60"
				>CLIENTS</a
			>
			<a
				href="/pricing"
				class="text-[0.85rem] font-light tracking-[2px] text-[#1a1a1a] transition-opacity hover:opacity-60"
				>PRICING</a
			>
			<a
				href="/book-us"
				class="text-[0.85rem] font-light tracking-[2px] text-[#1a1a1a] transition-opacity hover:opacity-60"
				>BOOK US</a
			>
		</div>
	</div>
</header>

<script>
	const menuBtn = document.getElementById("mobile-menu-btn");
	const mobileMenu = document.getElementById("mobile-menu");

	menuBtn?.addEventListener("click", () => {
		mobileMenu?.classList.toggle("hidden");
		mobileMenu?.classList.toggle("flex");
	});
</script>
