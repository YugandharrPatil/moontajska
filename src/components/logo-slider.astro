---

<section class="w-screen relative left-1/2 -translate-x-1/2 py-2 md:py-4">
	<div class="space-y-4 text-center">
		<p class="text-base text-muted-foreground font-jost font-regular">
			nos vidéos ont fait exploser la notoriété (et la vente) des startups, des
			applis, des marques DTC
		</p>

		<div class="relative w-full overflow-hidden py-4 border-y border-border">
			{/* Guides for sizing (30px gap centered vertically) */}
			<div class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 h-[24px] flex flex-col justify-between z-20">
				<hr class="w-full border-t border-red-500/80 border-dashed m-0" />
				<hr class="w-full border-t border-red-500/80 border-dashed m-0" />
			</div>

			<!-- Infinite ticker -->
			<div class="animate-marquee flex items-center gap-12 md:gap-16 whitespace-nowrap py-1">
				{
					// Duplicate twice for continuous seamless loop
					[...brands, ...brands].map((brand) => (
						<div class="flex items-center justify-center shrink-0 h-10 md:h-12 px-2 group opacity-75 hover:opacity-100 transition-opacity">
							<img
								src={brand.logo}
								alt={brand.alt}
								loading="lazy"
								class={cn(
									"h-7 w-auto object-contain select-none pointer-events-none dark:invert",
									typeof brand.size === "string" &&
										(brand.size.startsWith("h-")
											? brand.size
											: `h-[${brand.size}]`),
									typeof brand.size === "number" && `h-[${brand.size}px]`,
									brand.class,
								)}
								style={
									typeof brand.size === "number"
										? { height: `${brand.size}px` }
										: undefined
								}
							/>
						</div>
					))
				}
			</div>
		</div>
	</div>

