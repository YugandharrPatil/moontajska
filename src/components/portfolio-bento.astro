---
import VimeoEmbed from "./vimeo-embed.astro";
import SectionHeader from "./section-header.astro";
import { portfolioSections, type BentoSection } from "../data/portfolio";

export interface Props {
	sections?: BentoSection[];
	limit?: number;
	heading?: string;
	subheading?: string;
	showHeading?: boolean;
	showSectionTitles?: boolean;
	showSeeMore?: boolean;
	seeMoreHref?: string;
	seeMoreText?: string;
}

const {
	sections = portfolioSections,
	limit,
	showSectionTitles = false,
	showSeeMore = false,
} = Astro.props;

const displaySections = limit ? sections.slice(0, limit) : sections;
---

<div class="w-full space-y-6 md:space-y-8 pt-6 md:pt-12">
	<SectionHeader>
		<h1>des vidéos humouristiques, cinématographiques et publicitaires</h1>
		<p>
			100% de clients satisfaits, +400 entreprises accompagnées et des vidéos
			qui apportent vraiment des résultats.
		</p>
		<p>
			100% de clients satisfaits, +400 entreprises accompagnées et des vidéos
			qui apportent vraiment des résultats.
		</p>
	</SectionHeader>

	<div class="space-y-16 md:space-y-20">
		{displaySections.map((section) => (
			<section class="space-y-6 md:space-y-8" id={section.id}>
				{showSectionTitles && (
					<div class="text-center max-w-xl mx-auto space-y-1.5 px-4">
						<h3 class="text-2xl md:text-3xl font-heading font-medium tracking-tight text-foreground">
							{section.heading}
						</h3>
						<p class="font-subheading text-sm md:text-base text-muted-foreground font-normal">
							{section.subheading}
						</p>
					</div>
				)}

				<div class="grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-3 items-start">
					<!-- Left Column -->
					<div class="grid grid-cols-2 gap-2 md:gap-3">
						{section.leftVideos.map((video) => (
							<div class={video.span}>
								<VimeoEmbed
									videoId={video.id}
									title={video.title}
									aspect={video.aspect}
								/>
							</div>
						))}
					</div>

					<!-- Right Column -->
					<div class="grid grid-cols-2 gap-2 md:gap-3">
						{section.rightVideos.map((video) => (
							<div class={video.span}>
								<VimeoEmbed
									videoId={video.id}
									title={video.title}
									aspect={video.aspect}
								/>
							</div>
						))}
					</div>
				</div>
			</section>
		))}
	</div>
	{showSeeMore && (
		<div class="text-center pt-0 pb-4">
			<a
				href="/videos"
				class="inline-block text-base font-jost border border-black px-6 py-2 rounded-full transition-all hover:bg-black hover:text-white"
			>
				+ de vidéos
			</a>
		</div>
	)}
</div>
