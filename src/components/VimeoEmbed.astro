---
export interface Props {
	videoId?: string;
	width?: string | number;
	height?: string | number;
}

const { videoId = "1011950908", width = "100%", height = "100%" } = Astro.props;
---

<iframe 
	src={`https://player.vimeo.com/video/${videoId}`} 
	width={width} 
	height={height} 
	frameborder="0" 
	webkitallowfullscreen 
	mozallowfullscreen 
	allowfullscreen
></iframe>

<script is:inline src="https://player.vimeo.com/api/player.js"></script>
<script is:inline>
	// Your Vimeo SDK player script goes here
</script>
