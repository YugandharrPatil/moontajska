---
export interface Props {
	videoId: string;
	title?: string;
	aspect?: "portrait" | "landscape";
	class?: string;
}

const { videoId, title = "", aspect = "portrait", class: className = "" } = Astro.props;
---

<div class={`relative w-full overflow-hidden bg-black ${aspect === "portrait" ? "aspect-[9/16]" : "aspect-[16/9]"} ${className}`}>
	<iframe 
		src={`https://player.vimeo.com/video/${videoId}?autopause=0&loop=0&muted=0&title=1&portrait=1&byline=1`} 
		class="absolute inset-0 w-full h-full border-0" 
		allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
		referrerpolicy="strict-origin-when-cross-origin"
		allowfullscreen
		loading="lazy"
		title={title}
	></iframe>
</div>
