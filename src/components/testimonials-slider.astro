type Brand = {
	name: string;
	logo: string;
	alt: string;
};

const brands: Brand[] = [
	{ name: "Boku", logo: "/logos/boku.png", alt: "Boku logo" },
	{ name: "Urban Circus", logo: "/logos/urban-circus.svg", alt: "Urban Circus logo" },
	{ name: "Lingoda", logo: "/logos/lingoda.png", alt: "Lingoda logo" },
	{ name: "Livlab", logo: "/logos/livlab.svg", alt: "Livlab logo" },
	{ name: "Sisters Republic", logo: "/logos/sisters-republic.png", alt: "Sisters Republic logo" },
	{ name: "Saolar", logo: "/logos/saolar.png", alt: "Saolar logo" },
	{ name: "Gymglish", logo: "/logos/gymglish.png", alt: "Gymglish logo" },
	{ name: "Deep Belief", logo: "/logos/deep-belief.png", alt: "Deep Belief logo" },
	{ name: "900.care", logo: "/logos/900.png", alt: "900.care logo" },
	{ name: "Coiffissimo Professional", logo: "/logos/coiffissimo.png", alt: "Coiffissimo Professional logo" },
	{ name: "Tutoroo", logo: "/logos/tutoroo.png", alt: "Tutoroo logo" },
	{ name: "Mosaik", logo: "/logos/mosaik.svg", alt: "Mosaik logo" },
	{ name: "Caats", logo: "/logos/caats.png", alt: "Caats logo" },
	{ name: "Université Paris-Saclay", logo: "/logos/universite-paris-saclay.png", alt: "Université Paris-Saclay logo" },
	{ name: "Pronounce", logo: "/logos/pronounce.png", alt: "Pronounce logo" },
	{ name: "Kolsquare", logo: "/logos/kolsquare.png", alt: "Kolsquare logo" },
	{ name: "Lilly Skin", logo: "/logos/lily-skin.png", alt: "Lilly Skin logo" },
	{ name: "Western Union", logo: "/logos/western-union.png", alt: "Western Union logo" },
	{ name: "Multilangues Formation", logo: "/logos/multilangues.png", alt: "Multilangues Formation logo" },
	{ name: "La Bourse aux Livres", logo: "/logos/bourse.png", alt: "La Bourse aux Livres logo" },
];
---

<section class="w-full py-10 md:py-14 space-y-12">
	<!-- Logos Slider / Marquee -->
	<div class="space-y-4 text-center">
		<p
			class="text-xs uppercase tracking-[0.2em] font-medium text-muted-foreground"
		>
			Trusted by fast-growing brands & modern innovators
		</p>

		<div
			class="relative w-full overflow-hidden py-4 border-y border-border bg-muted/20"
		>
			<!-- Fade edge masks -->
			<div
				class="pointer-events-none absolute inset-y-0 left-0 w-16 md:w-32 bg-gradient-to-r from-background to-transparent z-10"
			>
			</div>
			<div
				class="pointer-events-none absolute inset-y-0 right-0 w-16 md:w-32 bg-gradient-to-l from-background to-transparent z-10"
			>
			</div>

			<!-- Infinite ticker -->
			<div
				class="animate-marquee flex items-center gap-12 md:gap-16 whitespace-nowrap py-1"
			>
				{
					// Duplicate twice for continuous seamless loop
					[...brands, ...brands].map((brand) => (
						<div class="flex items-center justify-center shrink-0 px-2 group opacity-75 hover:opacity-100 transition-opacity">
							<img
								src={brand.logo}
								alt={brand.alt}
								loading="lazy"
								class="h-7 md:h-8 max-w-32 md:max-w-40 w-auto object-contain dark:invert select-none pointer-events-none"
							/>
						</div>
					))
				}
			</div>
		</div>
	</div>

