const brands = [
	{ name: "900.care", tag: "Personal Care" },
	{ name: "Sisters Republic", tag: "Apparel" },
	{ name: "Boku", tag: "Hygiene Tech" },
	{ name: "Kolsquare", tag: "Influencer Marketing" },
	{ name: "Caats", tag: "Pet Nutrition" },
	{ name: "Spliiit", tag: "Fintech" },
	{ name: "La Bourse aux Livres", tag: "Re-commerce" },
	{ name: "Deep Belief", tag: "AI & Innovation" },
];
---

<section class="w-full py-10 md:py-14 space-y-12">
	<!-- Logos Slider / Marquee -->
	<div class="space-y-4 text-center">
		<p
			class="text-xs uppercase tracking-[0.2em] font-medium text-muted-foreground"
		>
			Trusted by fast-growing brands & modern innovators
		</p>

		<div
			class="relative w-full overflow-hidden py-4 border-y border-border bg-muted/20"
		>
			<!-- Fade edge masks -->
			<div
				class="pointer-events-none absolute inset-y-0 left-0 w-16 md:w-32 bg-gradient-to-r from-background to-transparent z-10"
			>
			</div>
			<div
				class="pointer-events-none absolute inset-y-0 right-0 w-16 md:w-32 bg-gradient-to-l from-background to-transparent z-10"
			>
			</div>

			<!-- Infinite ticker -->
			<div
				class="animate-marquee flex items-center gap-10 md:gap-16 whitespace-nowrap"
			>
				{
					// Duplicate twice for continuous seamless loop
					[...brands, ...brands].map((brand) => (
						<div class="flex items-center gap-3 group opacity-75 hover:opacity-100 transition-opacity">
							<span class="text-base md:text-lg font-semibold tracking-wider text-foreground uppercase">
								{brand.name}
							</span>
							<span class="text-[0.7rem] uppercase tracking-widest text-muted-foreground px-2 py-0.5 rounded-full border border-border bg-background/50">
								{brand.tag}
							</span>
							<span class="text-muted-foreground/30 ml-6 md:ml-10 select-none">
								/
							</span>
						</div>
					))
				}
			</div>
		</div>
	</div>

