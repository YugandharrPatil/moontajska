---
import CalEmbed from "./react/cal-embed";
import SectionHeader from "./section-heading.astro";

const calLink = import.meta.env.PUBLIC_CAL_LINK;
---

<section
	id="book-us"
	class="w-full space-y-6 md:space-y-8 flex flex-col items-center scroll-mt-24"
>
	<SectionHeader>
		<h1>parlez directement au réal</h1>
		<p>racontez-nous votre produit</p>
	</SectionHeader>

	<div class="w-full">
		<CalEmbed client:load calLink={calLink} />
	</div>
</section>
