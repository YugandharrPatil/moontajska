---
import { Icon } from "astro-icon/components";
---

<footer class="mt-20 py-10 flex flex-col items-center text-center space-y-6">
	<div class="flex flex-col space-y-1">
		<a
			href="mailto:hello@moontajska.com"
			class="text-xl font-light hover:opacity-70 transition-opacity"
			>hello@moontajska.com</a
		>
		<a
			href="tel:+33658485100"
			class="text-xl font-light hover:opacity-70 transition-opacity"
			>+33 6 58 48 51 00</a
		>
	</div>

	<div class="flex gap-4">
		<a
			href="https://www.facebook.com/moontajska/"
			class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:opacity-80 transition-opacity"
			aria-label="Facebook"
		>
			<Icon name="fa6-brands:facebook-f" class="w-5 h-5" />
		</a>
		<a
			href="https://www.instagram.com/moontajskaproductions/"
			class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:opacity-80 transition-opacity"
			aria-label="Instagram"
		>
			<Icon name="fa6-brands:instagram" class="w-5 h-5" />
		</a>
		<a
			href="https://www.youtube.com/channel/UCcntF6BbZmUkTFdrJx8ZJWQ"
			class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:opacity-80 transition-opacity"
			aria-label="YouTube"
		>
			<Icon name="fa6-brands:youtube" class="w-5 h-5" />
		</a>
		<a
			href="https://www.linkedin.com/in/krishna-bagadiya/"
			class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:opacity-80 transition-opacity"
			aria-label="LinkedIn"
		>
			<Icon name="fa6-brands:linkedin-in" class="w-5 h-5" />
		</a>
		<a
			href="http://vimeo.com/krishnabagadiya"
			class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center hover:opacity-80 transition-opacity"
			aria-label="Vimeo"
		>
			<Icon name="fa6-brands:vimeo-v" class="w-5 h-5" />
		</a>
	</div>

	<a
		href="/mentions-legales"
		class="text-sm text-gray-500 font-light mt-8 hover:text-black transition-colors"
		>Mentions légales</a
	>
</footer>
