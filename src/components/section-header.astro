---
export interface Props {
	heading: string;
	subheading?: string;
	class?: string;
}

const { heading, subheading, class: className = "" } = Astro.props;
---

<div class={`text-center max-w-5xl mx-auto space-y-3 px-4 ${className}`.trim()}>
	<h2 class="text-3xl md:text-[2rem] font-newsreader font-bold text-foreground">
		{heading}
	</h2>
	{
		subheading && (
			<p class="font-jost text-base md:text-[1.5rem] text-muted-foreground font-medium">
				{subheading}
			</p>
		)
	}
</div>
