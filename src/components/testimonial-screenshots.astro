---
import { Image } from "astro:assets";

// Audience comment screenshots
import imgDeck from "../assets/audience/Moontajska Deck FR 2025.png";
import img1 from "../assets/audience/Moontajska Deck FR 2025-1.png";
import img2 from "../assets/audience/Moontajska Deck FR 2025-2.png";
import img3 from "../assets/audience/Moontajska Deck FR 2025-3.png";
import img4 from "../assets/audience/Moontajska Deck FR 2025-4.png";
import img5 from "../assets/audience/Moontajska Deck FR 2025-5.png";
import img6 from "../assets/audience/Moontajska Deck FR 2025-6.png";
import img7 from "../assets/audience/Moontajska Deck FR 2025-7.png";
import img8 from "../assets/audience/Moontajska Deck FR 2025-8.png";
import img9 from "../assets/audience/Moontajska Deck FR 2025-9.png";
import img10 from "../assets/audience/Moontajska Deck FR 2025-10.png";
import img11 from "../assets/audience/Moontajska Deck FR 2025-11.png";

// Distribute images into 3 rows with balanced dimensions and aspect ratios
// Row 1 (slides right)
const row1 = [imgDeck, img1, img6, img10];
// Row 2 (slides left)
const row2 = [img4, img2, img7, img11];
// Row 3 (slides right)
const row3 = [img3, img5, img8, img9];

// Repeat 3 times in base (12 items) and duplicate (24 items) for a continuous seamless loop
const row1Items = [...row1, ...row1, ...row1];
const row1Track = [...row1Items, ...row1Items];

const row2Items = [...row2, ...row2, ...row2];
const row2Track = [...row2Items, ...row2Items];

const row3Items = [...row3, ...row3, ...row3];
const row3Track = [...row3Items, ...row3Items];
---

<section class="w-full pt-10 pb-8 space-y-8 md:space-y-10">
	<div class="border-t border-border pt-12 md:pt-16 space-y-8 md:space-y-10">
		<div class="text-center max-w-2xl mx-auto space-y-2 px-4">
			<h2 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground">
				Audience Comments
			</h2>
		</div>

		<!-- 3-row infinite slider in alternate directions -->
		<div class="relative w-full overflow-hidden py-2 space-y-4 sm:space-y-5">
			<!-- Fade edge masks -->
			<div
				class="pointer-events-none absolute inset-y-0 left-0 w-12 sm:w-20 md:w-32 bg-gradient-to-r from-[#f8f9fa] to-transparent z-10"
			>
			</div>
			<div
				class="pointer-events-none absolute inset-y-0 right-0 w-12 sm:w-20 md:w-32 bg-gradient-to-l from-[#f8f9fa] to-transparent z-10"
			>
			</div>

			<!-- Row 1: sliding right -->
			<div class="marquee-track-row1 flex items-center">
				{
					row1Track.map((img, idx) => (
						<div class="shrink-0 flex items-center justify-center h-28 sm:h-32 md:h-36 p-2.5 sm:p-3 rounded-xl md:rounded-2xl border border-border bg-card shadow-xs hover:border-primary/40 hover:shadow-md transition-all duration-200 mr-4 sm:mr-5">
							<Image
								src={img}
								alt={`Audience comment ${idx + 1}`}
								class="h-full w-auto max-w-none object-contain rounded-lg select-none pointer-events-none"
							/>
						</div>
					))
				}
			</div>

			<!-- Row 2: sliding left -->
			<div class="marquee-track-row2 flex items-center">
				{
					row2Track.map((img, idx) => (
						<div class="shrink-0 flex items-center justify-center h-28 sm:h-32 md:h-36 p-2.5 sm:p-3 rounded-xl md:rounded-2xl border border-border bg-card shadow-xs hover:border-primary/40 hover:shadow-md transition-all duration-200 mr-4 sm:mr-5">
							<Image
								src={img}
								alt={`Audience comment ${idx + 1}`}
								class="h-full w-auto max-w-none object-contain rounded-lg select-none pointer-events-none"
							/>
						</div>
					))
				}
			</div>

			<!-- Row 3: sliding right -->
			<div class="marquee-track-row3 flex items-center">
				{
					row3Track.map((img, idx) => (
						<div class="shrink-0 flex items-center justify-center h-28 sm:h-32 md:h-36 p-2.5 sm:p-3 rounded-xl md:rounded-2xl border border-border bg-card shadow-xs hover:border-primary/40 hover:shadow-md transition-all duration-200 mr-4 sm:mr-5">
							<Image
								src={img}
								alt={`Audience comment ${idx + 1}`}
								class="h-full w-auto max-w-none object-contain rounded-lg select-none pointer-events-none"
							/>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	@keyframes marquee-left {
		0% {
			transform: translateX(0%);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	@keyframes marquee-right {
		0% {
			transform: translateX(-50%);
		}
		100% {
			transform: translateX(0%);
		}
	}

	.marquee-track-row1 {
		display: flex;
		width: max-content;
		animation: marquee-right 200s linear infinite;
	}

	.marquee-track-row2 {
		display: flex;
		width: max-content;
		animation: marquee-left 200s linear infinite;
	}

	.marquee-track-row3 {
		display: flex;
		width: max-content;
		animation: marquee-right 200s linear infinite;
	}

	.marquee-track-row1:hover,
	.marquee-track-row2:hover,
	.marquee-track-row3:hover {
		animation-play-state: paused;
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track-row1,
		.marquee-track-row2,
		.marquee-track-row3 {
			animation-play-state: paused;
		}
	}
</style>
