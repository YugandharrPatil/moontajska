---
import { Icon } from "astro-icon/components";

const socialLinks = [
	{
		name: "Facebook",
		href: "https://www.facebook.com/moontajska/",
		icon: "fa6-brands:facebook-f",
	},
	{
		name: "Instagram",
		href: "https://www.instagram.com/moontajskaproductions/",
		icon: "fa6-brands:instagram",
	},
	{
		name: "YouTube",
		href: "https://www.youtube.com/channel/UCcntF6BbZmUkTFdrJx8ZJWQ",
		icon: "fa6-brands:youtube",
	},
	{
		name: "LinkedIn",
		href: "https://www.linkedin.com/in/krishna-bagadiya/",
		icon: "fa6-brands:linkedin-in",
	},
	{
		name: "Vimeo",
		href: "http://vimeo.com/krishnabagadiya",
		icon: "fa6-brands:vimeo-v",
	},
];
---

<footer class="mt-20 py-10 flex flex-col items-center text-center space-y-6">
	<div class="flex flex-col space-y-1">
		<a
			href="mailto:business@moontajska.com"
			class="text-xl font-light hover:opacity-70 transition-opacity"
			>business@moontajska.com</a
		>
		<a
			href="tel:+33658485100"
			class="text-xl font-light hover:opacity-70 transition-opacity"
			>+33 6 58 48 51 00</a
		>
	</div>

	<div class="flex gap-3">
		{
			socialLinks.map((link) => (
				<a
					href={link.href}
					target="_blank"
					rel="noopener noreferrer"
					class="w-8 h-8 bg-black text-white rounded-full flex items-center justify-center hover:opacity-80 transition-opacity"
					aria-label={link.name}
				>
					<Icon name={link.icon} class="w-4 h-4" />
				</a>
			))
		}
	</div>

	<a
		href="/mentions-legales"
		class="text-sm text-gray-500 font-light mt-8 hover:text-black transition-colors"
		>Mentions légales</a
	>
</footer>
