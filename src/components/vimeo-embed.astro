---
export type Props = {
	videoId: string;
	title?: string;
	aspect?: "portrait" | "landscape";
	class?: string;
	hero: boolean;
};

const {
	videoId = "",
	title = "",
	aspect = "portrait",
	class: className = "",
	hero = false,
} = Astro.props;

// Extract numeric ID whether user passes a clean ID (e.g. "881686470") or full URL (e.g. "https://vimeo.com/881686470")
const cleanId =
	videoId.toString().match(/(?:video\/|vimeo\.com\/|^)(\d+)/)?.[1] ||
	videoId.toString().replace(/[^0-9]/g, "") ||
	videoId;
---

<div
	class={`relative w-full overflow-hidden bg-black rounded-lg ${aspect === "portrait" ? "aspect-[9/16]" : "aspect-[16/9]"} ${className}`}
>
	{
		cleanId ? (
			<iframe
				src={`https://player.vimeo.com/video/${cleanId}?autopause=0&loop=0&muted=0&title=${hero ? "0" : "1"}&portrait=0&byline=0`}
				class="absolute inset-0 w-full h-full border-0"
				allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
				referrerpolicy="strict-origin-when-cross-origin"
				allowfullscreen
				loading="lazy"
				title={title || "Video"}
			/>
		) : (
			<div class="absolute inset-0 flex items-center justify-center text-muted-foreground bg-muted/40 text-sm">
				Video embed placeholder
			</div>
		)
	}
</div>
