---
import CaseCard from "../components/case-card.astro";
import SectionHeader from "../components/section-heading.astro";
import { blogPosts } from "../data/blog";
---

<section id="cases" class="w-full space-y-6 md:space-y-8">
	<SectionHeader>
		<h1>des études de cas</h1>
		<p>
		des paris risqués qui ont payé (et ont marqué le marché)
		</p>
	</SectionHeader>

	<!-- 3 Cards in a Single Row linking to LinkedIn -->
	<div class="grid grid-cols-1 gap-2 md:grid-cols-3 md:gap-3">
		{blogPosts.slice(0, 3).map((post) => <CaseCard post={post} />)}
	</div>
</section>
