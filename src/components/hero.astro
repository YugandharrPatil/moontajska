---
import VimeoEmbed from "./vimeo-embed.astro";

const HERO_VIDEO_ID = "882848412";

const HEADLINE = "des pubs drôles qui font se souvenir (et acheter)";
const SUBHEADLINE =
	"on transforme les produits quotidiens, complexes, ennuyeux ou tabous en vidéos que tout le monde partage";
---

<section class="w-full pt-4 pb-0 text-center md:pt-6">
	<div class="mx-auto max-w-6xl space-y-0 px-4 sm:px-8 md:px-12">
		<h1 class="font-newsreader text-foreground text-[1.625rem] leading-[1.2] font-semibold text-balance sm:text-4xl md:text-4xl">
			{HEADLINE}
		</h1>
		<p class="font-jost text-foreground mx-auto max-w-3xl text-[0.9375rem] leading-[1.35] font-normal sm:text-lg md:text-xl">
			{SUBHEADLINE}
		</p>
	</div>

	<!-- Hero Vimeo Video -->
	<div class="mx-auto mt-4 max-w-5xl">
		<div class="border-border relative w-full overflow-hidden rounded-xl border bg-black shadow-sm sm:rounded-2xl">
			<VimeoEmbed
				videoId={HERO_VIDEO_ID}
				title="Moontajska Featured Reel"
				aspect="landscape"
				class="w-full"
				hero
			/>
		</div>
	</div>
</section>
