---
import VimeoEmbed from "./vimeo-embed.astro";

interface Props {
	headline?: string;
	subheadline?: string;
	// Change this to your Vimeo link (e.g. "https://vimeo.com/881686470") or video ID (e.g. "881686470")
	videoId?: string;
}

const {
	headline = "Creative Video Ads That Scale Modern Brands",
	subheadline = "We produce high-impact social campaigns, commercial spots, and viral video formats engineered to captivate audiences and drive conversions.",
	videoId = "881686470", // Default Vimeo ID (User can replace with their link or ID)
} = Astro.props;
---

<section class="w-full pt-8 pb-12 md:pt-14 md:pb-16 text-center">
	<div class="max-w-3xl mx-auto space-y-4 px-4">
		<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-foreground leading-tight">
			{headline}
		</h1>
		<p class="text-base sm:text-lg text-muted-foreground font-normal max-w-2xl mx-auto leading-relaxed">
			{subheadline}
		</p>
	</div>

	<!-- Hero Vimeo Video -->
	<div class="mt-8 md:mt-10 max-w-5xl mx-auto px-4">
		<div class="relative w-full rounded-xl sm:rounded-2xl overflow-hidden border border-border shadow-sm bg-black">
			<VimeoEmbed videoId={videoId} title="Moontajska Featured Reel" aspect="landscape" class="w-full" />
		</div>
	</div>
</section>
