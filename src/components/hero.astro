---
import VimeoEmbed from "./vimeo-embed.astro";

const HERO_VIDEO_ID = "882848412";
---

<section class="w-full pt-6 pb-1 md:pt-16 md:pb-2 text-center">
	<div class="max-w-6xl mx-auto space-y-2 px-12">
		<h1 class="text-4xl sm:text-5xl md:text-4xl font-newsreader font-bold text-foreground">
			explosez vos ventes grâce à des vidéos performantes
		</h1>
		<p class="font-jost max-w-3xl text-2xl sm:text-lg font-medium md:text-xl text-foreground mx-auto">
			100% de clients satisfaits, +400 entreprises accompagnées et des vidéos
			qui apportent vraiment des résultats.
		</p>
	</div>

	<!-- Hero Vimeo Video -->
	<div class="mt-8 md:mt-10 w-full">
		<div class="relative w-full rounded-xl sm:rounded-2xl overflow-hidden border border-border shadow-sm bg-black">
			<VimeoEmbed
				videoId={HERO_VIDEO_ID}
				title="Moontajska Featured Reel"
				aspect="landscape"
				class="w-full"
				hero
			/>
		</div>
	</div>
</section>
