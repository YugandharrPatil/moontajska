---
import VimeoEmbed from "./vimeo-embed.astro";

const HERO_VIDEO_ID = "882848412";
---

<section class="w-full pt-2 pb-1 md:pt-4 md:pb-2 text-center">
	<div class="max-w-3xl mx-auto space-y-4 px-12">
		<h1
			class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground leading-tight"
		>
			Creative Video Ads That Scale Modern Brands
		</h1>
		<p
			class="text-base sm:text-lg text-muted-foreground font-normal max-w-2xl mx-auto leading-relaxed"
		>
			We produce high-impact social campaigns, commercial spots, and viral video
			formats engineered to captivate audiences and drive conversions.
		</p>
	</div>

	<!-- Hero Vimeo Video -->
	<div class="mt-8 md:mt-10 max-w-6xl mx-auto px-4">
		<div
			class="relative w-full rounded-xl sm:rounded-2xl overflow-hidden border border-border shadow-sm bg-black"
		>
			<VimeoEmbed
				videoId={HERO_VIDEO_ID}
				title="Moontajska Featured Reel"
				aspect="landscape"
				class="w-full"
				hero
			/>
		</div>
	</div>
</section>
