---
import Layout from "../../layouts/layout.astro";
import VimeoEmbed from "../../components/vimeo-embed.astro";
import { blogPosts, type BlogPost } from "../../data/blog";

export const prerender = true;

export function getStaticPaths() {
	return blogPosts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { id } = Astro.params;
const post: BlogPost | undefined =
	Astro.props.post || blogPosts.find((p) => p.id === id);

if (!post) {
	return Astro.redirect("/404");
}

const currentIndex = blogPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? blogPosts[currentIndex - 1] : null;
const nextPost =
	currentIndex < blogPosts.length - 1 ? blogPosts[currentIndex + 1] : null;
---

<Layout title={`${post.title} – Case Study`}>
	<main class="w-full max-w-4xl mx-auto px-4 py-8 md:px-8 md:py-16 space-y-10 md:space-y-12">
		<!-- Back link -->
		<div>
			<a
				href="/#cases"
				class="inline-flex items-center gap-2 text-xs md:text-sm font-medium uppercase tracking-[2px] text-muted-foreground hover:text-foreground transition-colors group"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="transition-transform group-hover:-translate-x-1"
				>
					<path d="m15 18-6-6 6-6"></path>
				</svg>
				<span>Back to Cases</span>
			</a>
		</div>

		<!-- Top Header Section -->
		<header class="space-y-6">
			<!-- Meta properties pills -->
			<div class="flex flex-wrap items-center gap-2.5 sm:gap-3 text-xs">
				<span
					class="font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-black text-white dark:bg-white dark:text-black"
				>
					Case Study
				</span>
				<span
					class="font-medium text-foreground px-2.5 py-1 rounded-full bg-white border border-border shadow-2xs"
				>
					{post.client}
				</span>
				<span class="text-muted-foreground">·</span>
				<span class="text-muted-foreground">{post.category}</span>
				<span class="text-muted-foreground">·</span>
				<span class="text-muted-foreground">{post.readTime}</span>
				<span class="text-muted-foreground">·</span>
				<span class="text-muted-foreground">{post.date}</span>
			</div>

			<!-- Title -->
			<h1
				class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-foreground leading-[1.15]"
			>
				{post.title}
			</h1>

			<p class="text-base sm:text-lg text-muted-foreground leading-relaxed max-w-3xl">
				{post.content.summary}
			</p>

			<!-- TOP STATS AS PROPERTIES (3 Stats) -->
			<div class="pt-2">
				<div class="text-xs uppercase tracking-[2px] font-semibold text-muted-foreground mb-3 flex items-center gap-2">
					<span class="w-2 h-2 rounded-full bg-black dark:bg-white inline-block"></span>
					Key Performance Properties
				</div>
				<div
					class="grid grid-cols-1 sm:grid-cols-3 gap-3 md:gap-4 p-4 md:p-6 rounded-2xl bg-white border border-border shadow-xs"
				>
					{
						post.stats.map((stat, idx) => (
							<div class="flex flex-col p-4 rounded-xl bg-muted/30 border border-border/60">
								<div class="text-xs uppercase tracking-[1.5px] font-medium text-muted-foreground">
									{stat.label}
								</div>
								<div class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground mt-1">
									{stat.value}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</header>

		<!-- Hero Image / Visual Media Banner -->
		<div
			class="relative w-full aspect-[16/9] overflow-hidden rounded-2xl border border-border shadow-xs bg-muted"
		>
			<img
				src={post.image}
				alt={post.title}
				class="w-full h-full object-cover select-none"
				loading="eager"
			/>
			<div
				class="absolute bottom-3 left-3 bg-black/75 backdrop-blur-xs text-white text-[11px] font-medium px-3 py-1 rounded-full uppercase tracking-wider"
			>
				Production Still · {post.client}
			</div>
		</div>

		<!-- VIDEO EMBED SECTION -->
		<section class="space-y-4 pt-2">
			<div class="flex items-center justify-between">
				<div class="space-y-1">
					<h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">
						Featured Video Embed
					</h2>
					<p class="text-xs sm:text-sm text-muted-foreground">
						Watch the campaign reel crafted by Moontajska
					</p>
				</div>
				<span class="text-xs font-medium uppercase tracking-wider px-2.5 py-1 rounded-md bg-muted text-muted-foreground border border-border">
					Vimeo HD
				</span>
			</div>

			<div class="rounded-2xl overflow-hidden border border-border shadow-sm bg-black">
				<VimeoEmbed
					videoId={post.videoId}
					title={post.title}
					aspect={post.videoAspect || "landscape"}
					class="w-full"
					hero={false}
				/>
			</div>
		</section>

		<!-- Article Content Body -->
		<article class="space-y-10 text-foreground text-base sm:text-lg leading-relaxed pt-4 border-t border-border">
			<!-- Challenge Section -->
			<section class="space-y-4">
				<h2 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground">
					The Challenge
				</h2>
				<p class="text-muted-foreground">
					{post.content.challenge}
				</p>
			</section>

			<!-- Creative Hook Callout -->
			<section
				class="p-6 md:p-8 rounded-2xl bg-muted/30 border-l-4 border-black dark:border-white space-y-3"
			>
				<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-muted-foreground">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<polygon points="5 3 19 12 5 21 5 3"></polygon>
					</svg>
					The 3-Second Visual Hook
				</div>
				<p class="text-base md:text-lg font-medium italic text-foreground leading-relaxed">
					"{post.content.creativeHook}"
				</p>
			</section>

			<!-- Strategic Pillars -->
			<section class="space-y-4">
				<h2 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground">
					Creative Strategy & Angle Testing
				</h2>
				<ul class="space-y-3">
					{
						post.content.strategy.map((item) => (
							<li class="flex items-start gap-3">
								<span class="text-black dark:text-white font-bold text-lg leading-none mt-1">
									✓
								</span>
								<span class="text-muted-foreground">{item}</span>
							</li>
						))
					}
				</ul>
			</section>

			<!-- Execution -->
			<section class="space-y-4">
				<h2 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground">
					Production & Rapid Iteration
				</h2>
				<p class="text-muted-foreground">
					{post.content.execution}
				</p>
			</section>

			<!-- Conclusion -->
			<section class="space-y-4 pt-2">
				<h2 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground">
					Key Takeaway
				</h2>
				<p class="text-muted-foreground">
					{post.content.conclusion}
				</p>
			</section>
		</article>

		<!-- Call to Action Banner -->
		<section
			class="p-8 md:p-12 rounded-2xl bg-black text-white text-center space-y-6"
		>
			<h2 class="text-2xl md:text-3xl font-bold tracking-tight">
				Want similar video ad performance for your brand?
			</h2>
			<p class="text-sm md:text-base text-gray-300 max-w-xl mx-auto leading-relaxed">
				We help modern brands craft high-converting video concepts, UGC formats, and commercial spots built to scale acquisition.
			</p>
			<div>
				<a
					href="/contact"
					class="inline-block px-8 py-3.5 rounded-full bg-white text-black font-semibold text-sm uppercase tracking-wider hover:bg-gray-100 transition-colors shadow-sm"
				>
					Start A Project
				</a>
			</div>
		</section>

		<!-- Prev / Next Navigation -->
		<nav class="pt-8 border-t border-border flex items-center justify-between gap-4">
			{
				prevPost ? (
					<a
						href={`/blog/${prevPost.id}`}
						class="flex flex-col text-left group max-w-[45%]"
					>
						<span class="text-xs uppercase tracking-wider text-muted-foreground flex items-center gap-1 group-hover:text-foreground">
							← Previous Case
						</span>
						<span class="text-sm font-medium text-foreground line-clamp-1 group-hover:underline">
							{prevPost.client}: {prevPost.title}
						</span>
					</a>
				) : (
					<div />
				)
			}
			{
				nextPost ? (
					<a
						href={`/blog/${nextPost.id}`}
						class="flex flex-col text-right group max-w-[45%]"
					>
						<span class="text-xs uppercase tracking-wider text-muted-foreground flex items-center justify-end gap-1 group-hover:text-foreground">
							Next Case →
						</span>
						<span class="text-sm font-medium text-foreground line-clamp-1 group-hover:underline">
							{nextPost.client}: {nextPost.title}
						</span>
					</a>
				) : (
					<div />
				)
			}
		</nav>
	</main>
</Layout>
