---
import Layout from "../layouts/layout.astro";
import { Image } from "astro:assets";
import clientsImg from "../assets/client-logos2b.png";
---

<Layout>
	<main class="max-w-[1400px] mx-auto px-6 py-16 md:px-12 md:py-24 text-center">
		<h1 class="text-4xl md:text-5xl font-light tracking-wide mb-16">
			Our Clients
		</h1>

		<section class="flex flex-col items-center">
			<div class="w-full max-w-[1000px] mb-8">
				<Image
					src={clientsImg}
					alt="Moontajska Clients"
					class="w-full h-auto object-contain"
				/>
			</div>
			<p class="text-xl md:text-2xl text-gray-700 font-light max-w-2xl">
				Moontajska is the creative force behind the successful campaigns of many
				French startups.
			</p>
		</section>
	</main>
</Layout>
