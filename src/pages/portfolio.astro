---
import Layout from "../layouts/layout.astro";
import SectionHeading from "../components/section-heading.astro";
import PortfolioFilter from "../components/react/portfolio-filter.tsx";
import AudienceComments from "../components/audience-comments.astro";
---

<Layout title="Portfolio">
	<main class="w-full max-w-300 mx-auto px-4 pt-8 pb-0 md:px-8 md:pt-16 md:pb-0 space-y-4 md:space-y-8">
		<!-- Section Header -->
		<SectionHeading>
			<h1>des pubs humouristiques et cinématographiques</h1>
			<p class="!font-normal">
				des vidéos que les gens regardent jusqu’au bout et partage avec leurs
				amis
			</p>
		</SectionHeading>

		<PortfolioFilter client:load />

		<div class="pt-6 md:pt-8">
			<AudienceComments />
		</div>
	</main>
</Layout>
