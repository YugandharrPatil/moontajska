---
import Layout from "../layouts/layout.astro";
import Hero from "../components/hero.astro";
import TestimonialsSlider from "../components/testimonials-slider.astro";
import PortfolioBento from "../components/portfolio-bento.astro";

const heroVideoId = "881686470";
---

<Layout>
	<main
		class="w-full max-w-300 mx-auto px-4 py-4 md:px-8 md:py-8 space-y-12 md:space-y-16"
	>
		<Hero
			headline="Creative Video Ads That Scale Modern Brands"
			subheadline="We produce high-impact social campaigns, commercial spots, and viral video formats engineered to captivate audiences and drive conversions."
			videoId={heroVideoId}
		/>

		<TestimonialsSlider />

		<PortfolioBento
			limit={1}
			heading="Portfolio"
			subheading="A curated showcase of our high-converting video productions, social campaigns, and commercial spots crafted for modern audiences."
			showSeeMore={true}
			seeMoreHref="/portfolio"
			seeMoreText="See More..."
		/>
	</main>
</Layout>
