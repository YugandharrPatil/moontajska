---
import Layout from "../layouts/layout.astro";
import Hero from "../components/hero.astro";
import TestimonialsSlider from "../components/testimonials-slider.astro";
import PortfolioBento from "../components/portfolio-bento.astro";
import ClientTestimonialsCarousel from "../components/react/client-testimonials-carousel.tsx";
import { blogPosts } from "../data/blog";
---

<Layout>
	<main
		class="w-full max-w-300 mx-auto px-4 pt-2 pb-8 md:px-8 md:pt-4 md:pb-12 space-y-6 md:space-y-8"
	>
		<Hero />

		<TestimonialsSlider />

		<PortfolioBento
			limit={1}
			heading="Portfolio"
			subheading="A curated showcase of our high-converting video productions, social campaigns, and commercial spots crafted for modern audiences."
			showSeeMore={true}
			seeMoreHref="/portfolio"
			seeMoreText="See More..."
		/>

		<!-- Client Testimonials Carousel -->
		<ClientTestimonialsCarousel client:load />

		<!-- Cases / Blog Section -->
		<section id="cases" class="w-full space-y-8 md:space-y-10 pt-4">
			<div class="text-center max-w-2xl mx-auto space-y-3 px-4">
				<h2 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground">
					Cases
				</h2>
				<p class="text-sm md:text-base text-muted-foreground font-normal leading-relaxed">
					In-depth breakdowns of our creative strategies, viral hooks, and high-converting video campaigns.
				</p>
			</div>

			<!-- 3 Cards in a Single Row -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
				{
					blogPosts.slice(0, 3).map((post) => (
						<a
							href={`/blog/${post.id}`}
							class="group relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white border border-border shadow-xs hover:border-black/30 hover:shadow-md transition-all duration-300 text-left"
						>
							<!-- Image Banner inside Card -->
							<div class="relative w-full aspect-[16/10] overflow-hidden bg-muted">
								<img
									src={post.image}
									alt={post.title}
									class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
								<div class="absolute top-3 left-3 flex items-center gap-2">
									<span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-black/75 backdrop-blur-xs text-white">
										{post.client}
									</span>
								</div>
							</div>

							<!-- Card Body -->
							<div class="p-5 flex-1 flex flex-col justify-between space-y-4">
								<div class="space-y-2">
									<h3 class="text-base sm:text-lg font-bold tracking-tight text-foreground group-hover:text-primary transition-colors leading-snug line-clamp-2">
										{post.title}
									</h3>
									<p class="text-xs sm:text-sm text-muted-foreground leading-relaxed line-clamp-2">
										{post.excerpt}
									</p>
								</div>

								<!-- Action Link -->
								<div class="pt-3 border-t border-border flex items-center justify-end">
									<span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-foreground group-hover:translate-x-1 transition-transform">
										<span>Read Case</span>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="13"
											height="13"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M5 12h14"></path>
											<path d="m12 5 7 7-7 7"></path>
										</svg>
									</span>
								</div>
							</div>
						</a>
					))
				}
			</div>
		</section>
	</main>
</Layout>
