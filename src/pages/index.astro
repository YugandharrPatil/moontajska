---
import BookUs from "@/components/book-us.astro";
import Cases from "@/components/cases.astro";
import ClientTestimonials from "@/components/client-testimonials.astro";
import Hero from "../components/hero.astro";
import LogoSlider from "../components/logo-slider.astro";
import PortfolioBento from "../components/portfolio-bento.astro";
import Layout from "../layouts/layout.astro";
---

<Layout>
	<main class="mx-auto w-full max-w-300 space-y-12 px-4 pt-0 pb-0 md:space-y-16 md:px-8 md:pt-2 md:pb-0">
		<Hero />
		<LogoSlider />
		<PortfolioBento limit={1} showSeeMore={true} />
		<ClientTestimonials />
		<Cases />
		<BookUs />
	</main>
</Layout>
