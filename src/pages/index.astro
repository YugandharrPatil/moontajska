---
import Layout from "../layouts/Layout.astro";
import VimeoEmbed from "../components/VimeoEmbed.astro";

interface VideoItem {
	id: string;
	title: string;
	aspect: "portrait" | "landscape";
	span: string;
}

interface BentoSection {
	heading: string;
	subheading: string;
	leftVideos: VideoItem[];
	rightVideos: VideoItem[];
}

const sections: BentoSection[] = [
	{
		heading: "Featured Highlights",
		subheading: "High-impact social campaigns and commercials",
		leftVideos: [
			{ id: "1011950908", title: "900 | Matrix", aspect: "portrait", span: "col-span-1" },
			{ id: "1011954936", title: "900 | Trump", aspect: "portrait", span: "col-span-1" },
			{ id: "769455742", title: "Deep Belief", aspect: "landscape", span: "col-span-2" },
		],
		rightVideos: [
			{ id: "881686470", title: "Sisters Republic | Chaperon Rouge", aspect: "landscape", span: "col-span-2" },
			{ id: "1011936857", title: "900 | Baywatch", aspect: "portrait", span: "col-span-1" },
			{ id: "1011968294", title: "900 | Dealers", aspect: "portrait", span: "col-span-1" },
		],
	},
	{
		heading: "Creative Spotlight",
		subheading: "Engaging stories and narrative video formats",
		leftVideos: [
			{ id: "1011953182", title: "900 | Thanos", aspect: "portrait", span: "col-span-1" },
			{ id: "1011965145", title: "Boku | Pshiit", aspect: "portrait", span: "col-span-1" },
			{ id: "918612476", title: "Boku | Alien", aspect: "landscape", span: "col-span-2" },
			{ id: "1051332477", title: "Kolsquare | Influencer Marketing", aspect: "landscape", span: "col-span-2" },
		],
		rightVideos: [
			{ id: "882848412", title: "Sisters Republic | Barbie", aspect: "landscape", span: "col-span-2" },
			{ id: "851884840", title: "Boku | Diner de C*l", aspect: "landscape", span: "col-span-2" },
			{ id: "1011969359", title: "Boku | Metro", aspect: "portrait", span: "col-span-1" },
			{ id: "1011924278", title: "900 | Cemetery", aspect: "portrait", span: "col-span-1" },
		],
	},
	{
		heading: "Brand Originals",
		subheading: "Short-form content crafted for modern audiences",
		leftVideos: [
			{ id: "918597931", title: "Caats | Chanson", aspect: "landscape", span: "col-span-2" },
			{ id: "1051884000", title: "Bourse aux Livres | Appart", aspect: "portrait", span: "col-span-1" },
			{ id: "1011927125", title: "900 | Histoire Gel Douche", aspect: "portrait", span: "col-span-1" },
		],
		rightVideos: [
			{ id: "918611255", title: "Boku | A**holes Anonymous", aspect: "landscape", span: "col-span-2" },
			{ id: "1064022854", title: "Spliiit | Scooter", aspect: "portrait", span: "col-span-1" },
			{ id: "1064022944", title: "Spliiit | Newspaper", aspect: "portrait", span: "col-span-1" },
		],
	},
];
---

<Layout>
	<main class="w-full max-w-300 mx-auto px-4 py-6 md:px-8 md:py-8 space-y-16 md:space-y-20">
		{
			sections.map((section) => (
				<section class="space-y-6 md:space-y-8">
					<div class="text-center max-w-xl mx-auto space-y-2">
						<h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-[#1a1a1a]">
							{section.heading}
						</h2>
						<p class="text-sm md:text-base text-gray-500 font-normal">
							{section.subheading}
						</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-3 items-start">
						<!-- Left Column -->
						<div class="grid grid-cols-2 gap-2 md:gap-3">
							{
								section.leftVideos.map((video) => (
									<div class={video.span}>
										<VimeoEmbed videoId={video.id} title={video.title} aspect={video.aspect} />
									</div>
								))
							}
						</div>

						<!-- Right Column -->
						<div class="grid grid-cols-2 gap-2 md:gap-3">
							{
								section.rightVideos.map((video) => (
									<div class={video.span}>
										<VimeoEmbed videoId={video.id} title={video.title} aspect={video.aspect} />
									</div>
								))
							}
						</div>
					</div>
				</section>
			))
		}
	</main>
</Layout>
