---
import Layout from "../layouts/layout.astro";
import Hero from "../components/hero.astro";
import SectionHeader from "../components/section-header.astro";
import TestimonialsSlider from "../components/testimonials-slider.astro";
import PortfolioBento from "../components/portfolio-bento.astro";
import ClientTestimonialsGrid from "../components/client-testimonials-grid.astro";
import { blogPosts } from "../data/blog";
---

<Layout>
	<main class="w-full max-w-300 mx-auto px-4 pt-2 pb-8 md:px-8 md:pt-4 md:pb-12 space-y-6 md:space-y-8">
		<Hero />

		<TestimonialsSlider />

		<PortfolioBento
			limit={1}
			showSeeMore={true}
			seeMoreHref="/portfolio"
			seeMoreText="See More..."
		/>

		<!-- Client Testimonials Grid -->
		<section class="w-full pt-10 pb-8 space-y-8 md:space-y-10">
			<SectionHeader
				heading="des clients en parlent"
				subheading="100% de clients satisfaits, +400 entreprises accompagnées et des vidéos qui apportent vraiment des résultats."
			/>
			<ClientTestimonialsGrid />
		</section>

		<!-- Cases / Blog Section -->
		<section id="cases" class="w-full space-y-8 md:space-y-10 pt-4">
			<SectionHeader
				heading="des études de cas"
				subheading="100% de clients satisfaits, +400 entreprises accompagnées et des vidéos qui apportent vraiment des résultats."
			/>

			<!-- 3 Cards in a Single Row linking to LinkedIn -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
				{blogPosts.slice(0, 3).map((post) => (
					<a
						href={post.linkedinUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="group relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white border border-border shadow-xs hover:border-black/30 hover:shadow-md transition-all duration-300 text-left"
					>
						<!-- Image Banner inside Card -->
						<div class="relative w-full aspect-[2/1] overflow-hidden bg-muted">
							<img
								src={post.image}
								alt={post.title}
								class="w-full h-full object-cover transition-transform duration-500"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
							<div class="absolute top-3 left-3 flex items-center gap-2">
								<span class="text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-black/75 backdrop-blur-xs text-white">
									{post.client}
								</span>
							</div>
						</div>

						<!-- Card Body -->
						<div class="p-5 flex-1 flex flex-col font-jost justify-between space-y-4">
							<div class="space-y-2 text-center">
								<h3 class="text-base font-bold text-foreground">
									{post.title}
								</h3>
								<p class="text-xs font-medium sm:text-sm text-muted-foreground leading-relaxed line-clamp-2">
									{post.excerpt}
								</p>
							</div>
						</div>
					</a>
				))}
			</div>
		</section>
	</main>
</Layout>
