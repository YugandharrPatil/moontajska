---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import talentImg from '../assets/talent-img.jpg';
---

<Layout>
	<main class="max-w-[1400px] mx-auto px-6 py-16 md:px-12 md:py-24 text-center flex justify-center">
		<Image src={talentImg} alt="Moontajska Talents" class="w-full max-w-[600px] h-auto object-contain" />
	</main>
</Layout>
