---
import Layout from "../layouts/layout.astro";
import { Image } from "astro:assets";
import contactImg from "../assets/Contact-icon-300x221.jpg";
import BookUsForm from "../components/react/contact-form";
import CalEmbed from "../components/react/cal-embed";

const calLink = import.meta.env.PUBLIC_CAL_LINK || "moontajska/30min";
---

<Layout title="Book Us – Contact & Scheduling">
	<main class="max-w-[1400px] mx-auto px-6 py-16 md:px-12 md:py-24 text-center">
		<h1 class="text-4xl md:text-5xl font-light tracking-wide mb-4">Book Us</h1>
		<p class="text-gray-600 text-lg max-w-2xl mx-auto mb-16 leading-relaxed font-light">
			Schedule a 30-minute discovery call directly on our calendar, or leave us a message to discuss your next video production.
		</p>

		<!-- Cal.com 30-Minute Meeting Embed Section -->
		<section class="mb-24 flex flex-col items-center">
			<div class="text-center mb-8 max-w-xl">
				<div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded-full bg-black/5 text-gray-800 text-xs font-medium uppercase tracking-wider">
					Instant Booking
				</div>
				<h2 class="text-2xl md:text-3xl font-light text-gray-900 mb-2">
					Schedule a 30-Minute Call
				</h2>
				<p class="text-gray-500 text-sm">
					Pick a date and time that suits you. A Google Meet / video link will be automatically generated.
				</p>
			</div>

			<div class="w-full max-w-[1050px] mx-auto">
				<CalEmbed client:load calLink={calLink} />
			</div>
		</section>

		<!-- Written Inquiry / Contact Form Section -->
		<section id="send-message" class="flex flex-col items-center">
			<div class="text-center mb-8 max-w-xl">
				<div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded-full bg-black/5 text-gray-800 text-xs font-medium uppercase tracking-wider">
					Direct Message
				</div>
				<h2 class="text-2xl md:text-3xl font-light text-gray-900 mb-2">
					Prefer to send a message?
				</h2>
				<p class="text-gray-500 text-sm">
					Reach out with your project scope, custom quote request, or general questions.
				</p>
			</div>

			<div
				class="bg-white rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.05)] flex flex-col md:flex-row w-full max-w-[950px] border border-gray-100"
			>
				<div class="flex-1 bg-gray-50 flex items-center justify-center p-8">
					<Image
						src={contactImg}
						alt="Contact Us"
						class="w-full h-auto max-w-[300px] object-contain"
					/>
				</div>
				<div class="flex-[1.5] p-8 md:p-14 text-left">
					<h3 class="text-2xl md:text-3xl font-light mb-3">
						Let's create something amazing together.
					</h3>
					<p class="text-gray-600 mb-6 leading-relaxed text-sm">
						Fill out the form below or reach out directly via email or phone.
					</p>

					<div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-8 pb-6 border-b border-gray-100">
						<div>
							<span class="block text-xs uppercase tracking-wider text-gray-400 font-medium">Email</span>
							<a
								href="mailto:business@moontajska.com"
								class="text-base font-medium text-black underline decoration-transparent hover:decoration-black transition-colors duration-300"
								>business@moontajska.com</a
							>
						</div>
						<div class="hidden sm:block text-gray-300">|</div>
						<div>
							<span class="block text-xs uppercase tracking-wider text-gray-400 font-medium">Phone</span>
							<a
								href="tel:+33658485100"
								class="text-base font-medium text-black underline decoration-transparent hover:decoration-black transition-colors duration-300"
								>+33 6 58 48 51 00</a
							>
						</div>
					</div>

					<BookUsForm client:load />
				</div>
			</div>
		</section>
	</main>
</Layout>
