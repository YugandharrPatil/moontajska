---
import Layout from "../layouts/layout.astro";
import { Image } from "astro:assets";
import contactImg from "../assets/Contact-icon-300x221.jpg";
import BookUsForm from "../components/react/contact-form";
---

<Layout>
	<main class="max-w-[1400px] mx-auto px-6 py-16 md:px-12 md:py-24 text-center">
		<h1 class="text-4xl md:text-5xl font-light tracking-wide mb-16">Book Us</h1>

		<section class="flex justify-center">
			<div
				class="bg-white rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.05)] flex flex-col md:flex-row w-full max-w-[900px]"
			>
				<div class="flex-1 bg-gray-50 flex items-center justify-center p-8">
					<Image
						src={contactImg}
						alt="Contact Us"
						class="w-full h-auto max-w-[300px] object-contain"
					/>
				</div>
				<div class="flex-[1.5] p-8 md:p-16 text-left">
					<h2 class="text-3xl font-light mb-4">
						Let's create something amazing together.
					</h2>
					<p class="text-gray-600 mb-8 leading-relaxed">
						Reach out to discuss your project, request a custom quote, or just
						to say hello.
					</p>

					<div class="flex flex-col gap-2 mb-12">
						<a
							href="mailto:hello@moontajska.com"
							class="text-xl font-medium text-black underline decoration-transparent hover:decoration-black transition-colors duration-300"
							>hello@moontajska.com</a
						>
						<a
							href="tel:+33658485100"
							class="text-xl font-medium text-black underline decoration-transparent hover:decoration-black transition-colors duration-300"
							>+33 6 58 48 51 00</a
						>
					</div>

					<BookUsForm client:load />
				</div>
			</div>
		</section>
	</main>
</Layout>
